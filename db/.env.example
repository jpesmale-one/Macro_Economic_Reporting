# Copy this file to db/.env and paste your real connection string.
#
#   cp db/.env.example db/.env
#
# db/.env is gitignored; this example file is not, and must never hold a
# real password.
#
# Get the string from the Supabase dashboard: the `Connect` button in the
# project's top bar -> Connection string tab -> Transaction pooler.
# Replace [YOUR-PASSWORD] with the database password you set when creating
# the project - the dashboard shows the placeholder, not the password.

SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
